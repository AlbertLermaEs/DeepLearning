{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/article/**",
              "components/charts/**",
              "components/controls/**",
              "components/diagram/**",
              "components/display/**",
              "slides/**",
              "ui_kits/article/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:KaTeX_Main|Source Sans 3|Source Serif 4|Source Code Pro))/i]",
        "message": "Font not provided by the design system. Available: KaTeX_Main, Source Sans 3, Source Serif 4, Source Code Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|description|authors|published|doi|width|style|key|ref|className|style|children)$/]",
        "message": "<ArticleHeader> doesn't accept that prop. Declared props: kicker, title, description, authors, published, doi, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|width|barHeight|gap|labelWidth|max|highlight|color|highlightColor|format|style|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, width, barHeight, gap, labelWidth, max, highlight, color, highlightColor, format, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brace'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|length|direction|depth|label|labelBold|key|ref|className|style|children)$/]",
        "message": "<Brace> doesn't accept that prop. Declared props: x, y, length, direction, depth, label, labelBold."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brace'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|left|down|up)$/]",
        "message": "<Brace> direction must be one of 'right' | 'left' | 'down' | 'up'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|fullWidth|onClick|type|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, fullWidth, onClick, type, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
